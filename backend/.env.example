# Chave grátis em https://aistudio.google.com/apikey (não pede cartão)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Vazio = store em memória salvo em data/store (bom pra rodar local).
# Com Postgres + pgvector (ex: Supabase), cole a connection string aqui.
DATABASE_URL=
SEED_ON_STARTUP=true

ALLOW_UPLOAD=true
MAX_UPLOAD_MB=15
MAX_PAGES=200
RATE_LIMIT_CHAT_PER_HOUR=40
RATE_LIMIT_UPLOAD_PER_HOUR=5
CORS_ORIGINS=*
